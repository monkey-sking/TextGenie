{
  "name": {
    "en": "TextGenie",
    "zh-Hans": "文灵"
  },
  "identifier": "com.popclip.extension.textgenie",
  "description": {
    "en": "Magical text assistant",
    "zh-Hans": "魔法文本助手"
  },
  "icon": "icon.svg",
  "popclipVersion": 4586,
  "entitlements": [
    "network"
  ],
  "options": [
    {
      "identifier": "translationService",
      "label": {
        "en": "Translation Service",
        "zh-Hans": "翻译服务"
      },
      "type": "multiple",
      "values": [
        "google",
        "google-cloud",
        "deepl",
        "openai",
        "gemini",
        "custom",
        "bob",
        "eudic"
      ],
      "valueLabels": [
        "🌐 Google (免 Key/实验)",
        "☁️ Google Cloud (官方)",
        "🔷 DeepL",
        "🤖 OpenAI",
        "✨ Gemini",
        "⚙️ Custom",
        "📖 Bob",
        "📚 Eudic"
      ],
      "defaultValue": "google"
    },
    {
      "identifier": "targetLanguage",
      "label": {
        "en": "Translation Target",
        "zh-Hans": "翻译目标语言"
      },
      "type": "multiple",
      "values": [
        "auto",
        "zh-CN",
        "en",
        "ja",
        "ko",
        "fr",
        "de",
        "es",
        "ru"
      ],
      "valueLabels": [
        "🔄 Auto",
        "🇨🇳 中文",
        "🇺🇸 English",
        "🇯🇵 日本語",
        "🇰🇷 한국어",
        "🇫🇷 Français",
        "🇩🇪 Deutsch",
        "🇪🇸 Español",
        "🇷🇺 Русский"
      ],
      "defaultValue": "auto"
    },
    {
      "identifier": "apiKey",
      "label": {
        "en": "API Key",
        "zh-Hans": "API 密钥"
      },
      "type": "string",
      "description": {
        "en": "Required for Google Cloud/DeepL/OpenAI/Gemini, optional for Custom",
        "zh-Hans": "Google Cloud/DeepL/OpenAI/Gemini 必填，自定义接口按需填写"
      }
    },
    {
      "identifier": "customApiUrl",
      "label": {
        "en": "Custom API URL",
        "zh-Hans": "自定义 API 地址"
      },
      "type": "string",
      "description": {
        "en": "OpenAI-compatible base URL or full chat completions endpoint",
        "zh-Hans": "支持 OpenAI 兼容的基础地址，或完整 chat completions 接口"
      }
    },
    {
      "identifier": "customModel",
      "label": {
        "en": "Custom Model",
        "zh-Hans": "自定义模型"
      },
      "type": "string",
      "description": {
        "en": "Required for Custom. Use a model name supported by your server",
        "zh-Hans": "自定义接口必填。请填写你的服务实际支持的模型名"
      }
    },
    {
      "identifier": "customPrompt",
      "label": {
        "en": "Custom Prompt",
        "zh-Hans": "自定义提示词"
      },
      "type": "string"
    },
    {
      "identifier": "targetCurrency",
      "label": {
        "en": "Target Currency",
        "zh-Hans": "目标货币"
      },
      "type": "multiple",
      "values": [
        "AUTO",
        "CNY",
        "USD",
        "EUR",
        "GBP",
        "JPY",
        "HKD",
        "KRW",
        "TWD",
        "SGD",
        "AUD",
        "CAD",
        "CHF",
        "NZD",
        "INR",
        "THB",
        "MYR",
        "RUB"
      ],
      "valueLabels": [
        "🌐 自动（根据设备地区）",
        "¥ CNY",
        "$ USD",
        "€ EUR",
        "£ GBP",
        "¥ JPY",
        "HK$ HKD",
        "₩ KRW",
        "NT$ TWD",
        "S$ SGD",
        "A$ AUD",
        "C$ CAD",
        "CHF",
        "NZ$ NZD",
        "₹ INR",
        "฿ THB",
        "RM MYR",
        "₽ RUB"
      ],
      "defaultValue": "AUTO"
    },
    {
      "identifier": "pureNumberMode",
      "label": {
        "en": "Pure Number Handling",
        "zh-Hans": "纯数字处理"
      },
      "type": "multiple",
      "values": [
        "currency",
        "translate"
      ],
      "valueLabels": [
        {
          "en": "As Currency",
          "zh-Hans": "视为货币"
        },
        {
          "en": "As Text",
          "zh-Hans": "视为文本"
        }
      ],
      "defaultValue": "currency"
    },
    {
      "identifier": "openUrls",
      "label": {
        "en": "Open URLs",
        "zh-Hans": "打开网址"
      },
      "type": "boolean",
      "defaultValue": true
    },
    {
      "identifier": "enableTerminal",
      "label": {
        "en": "Enable Terminal Action",
        "zh-Hans": "开启终端功能"
      },
      "type": "boolean",
      "defaultValue": true
    },
    {
      "identifier": "preferredTerminal",
      "label": {
        "en": "Terminal Emulator",
        "zh-Hans": "终端模拟器"
      },
      "type": "multiple",
      "values": [
        "terminal",
        "iterm2",
        "auto"
      ],
      "valueLabels": [
        "Terminal",
        "iTerm2",
        "Auto"
      ],
      "defaultValue": "terminal"
    },
    {
      "identifier": "preferredFileManager",
      "label": {
        "en": "Preferred File Manager",
        "zh-Hans": "首选文件管理器"
      },
      "type": "multiple",
      "values": [
        "finder",
        "pathfinder",
        "forklift",
        "qspace",
        "commanderone",
        "marta"
      ],
      "valueLabels": [
        "Finder",
        "Path Finder",
        "ForkLift",
        "QSpace",
        "Commander One",
        "Marta"
      ],
      "defaultValue": "finder"
    },
    {
      "identifier": "useNewTab",
      "label": {
        "en": "Use New Tab",
        "zh-Hans": "在新标签页打开"
      },
      "type": "boolean",
      "defaultValue": false
    }
  ],
  "actions": [
    {
      "title": {
        "en": "Open URL",
        "zh-Hans": "打开网址"
      },
      "icon": "url.png",
      "javascript file": "url.js",
      "requirements": [
        "text",
        "option-openUrls=1"
      ],
      "regular expression": "(?i)^(https?://|www\\.|[a-z0-9-]+\\.[a-z]{2,}(/.*)?$|(\\d{1,3}\\.){3}\\d{1,3}(:\\d+)?(/.*)?$|localhost(:\\d+)?(/.*)?$)"
    },
    {
      "title": {
        "en": "Convert",
        "zh-Hans": "汇率转换"
      },
      "icon": "currency.png",
      "javascript file": "currency.js",
      "after": "preview-result",
      "regular expression": "(?i).*(\\$|[¥￥€£₹₩₽฿]|USD|CNY|EUR|GBP|JPY|HKD|KRW|TWD|SGD|AUD|CAD|CHF|NZD|MYR|THB|INR|RUB|元|币|镑|法郎|铢|卢|円|林吉特).*"
    },
    {
      "title": {
        "en": "Run in Terminal",
        "zh-Hans": "填入终端"
      },
      "icon": "terminal.png",
      "applescript file": "terminal.applescript",
      "requirements": [
        "text",
        "option-enableTerminal=1",
        "option-preferredTerminal=terminal"
      ],
      "regular expression": "(?i)^([$#>%\\s]*)(git|npm|yarn|pnpm|docker|kubectl|brew|apt|ls|cd|pwd|cat|grep|ssh|curl|wget|chmod|sudo|mkdir|rm|cp|mv|ps|kill|top|find|man|node|python[0-9]*|pip[0-9]*|go|rustc|cargo|make|sh|bash|zsh|touch|which|code|open|gh|vercel|npx|deno|bun|java|rails|php|composer|gem|bundle|poetry|conda|nvm|sdk|flutter|pod|aws|gcloud|az|helm|terraform|ansible|pm2|nodemon|tsx|swc|babel|eslint|prettier|jest|vitest|playwright|lerna|nx|turbo|systemctl|export|set|env|alias|source|pkill|service|codex|claude|opencode|aider|gemini|cursor|copilot|ollama|uv|uvx|pipx|rye|mise|fnm|volta|xcodebuild|swift|xcrun|defaults|launchctl|networkQuality|ifconfig|netstat|lsof|jq|yq|rg|fd|bat|eza|tree|du|df|tar|unzip|zip|rsync|scp|sftp|act|just|task|watchexec|http|xh|sqlite3|psql|mysql|redis-cli|mongosh|firebase|supabase|wrangler|fly|railway|render|pulumi|tofu|packer|vagrant|podman|nerdctl|colima|limactl|mas|shortcuts|osascript|plutil|codesign|spctl|xattr|mdls|mdfind|sips|afconvert|say|pbcopy|pbpaste|ditto|diskutil|softwareupdate|tmutil|sysdiagnose|scutil|dscacheutil|security|profiles|pkgutil|installer|system_profiler|ioreg|powermetrics|pmset|caffeinate|screencapture|qlmanage)\\b.*"
    },
    {
      "title": {
        "en": "Run in Terminal",
        "zh-Hans": "填入终端"
      },
      "icon": "terminal.png",
      "applescript file": "iterm2.applescript",
      "requirements": [
        "text",
        "option-enableTerminal=1",
        "option-preferredTerminal=iterm2"
      ],
      "app": {
        "name": "iTerm2",
        "link": "https://iterm2.com/",
        "bundleIdentifiers": [
          "com.googlecode.iterm2"
        ]
      },
      "regular expression": "(?i)^([$#>%\\s]*)(git|npm|yarn|pnpm|docker|kubectl|brew|apt|ls|cd|pwd|cat|grep|ssh|curl|wget|chmod|sudo|mkdir|rm|cp|mv|ps|kill|top|find|man|node|python[0-9]*|pip[0-9]*|go|rustc|cargo|make|sh|bash|zsh|touch|which|code|open|gh|vercel|npx|deno|bun|java|rails|php|composer|gem|bundle|poetry|conda|nvm|sdk|flutter|pod|aws|gcloud|az|helm|terraform|ansible|pm2|nodemon|tsx|swc|babel|eslint|prettier|jest|vitest|playwright|lerna|nx|turbo|systemctl|export|set|env|alias|source|pkill|service|codex|claude|opencode|aider|gemini|cursor|copilot|ollama|uv|uvx|pipx|rye|mise|fnm|volta|xcodebuild|swift|xcrun|defaults|launchctl|networkQuality|ifconfig|netstat|lsof|jq|yq|rg|fd|bat|eza|tree|du|df|tar|unzip|zip|rsync|scp|sftp|act|just|task|watchexec|http|xh|sqlite3|psql|mysql|redis-cli|mongosh|firebase|supabase|wrangler|fly|railway|render|pulumi|tofu|packer|vagrant|podman|nerdctl|colima|limactl|mas|shortcuts|osascript|plutil|codesign|spctl|xattr|mdls|mdfind|sips|afconvert|say|pbcopy|pbpaste|ditto|diskutil|softwareupdate|tmutil|sysdiagnose|scutil|dscacheutil|security|profiles|pkgutil|installer|system_profiler|ioreg|powermetrics|pmset|caffeinate|screencapture|qlmanage)\\b.*"
    },
    {
      "title": {
        "en": "Run in Terminal",
        "zh-Hans": "填入终端"
      },
      "icon": "terminal.png",
      "applescript file": "auto.applescript",
      "requirements": [
        "text",
        "option-enableTerminal=1",
        "option-preferredTerminal=auto"
      ],
      "regular expression": "(?i)^([$#>%\\s]*)(git|npm|yarn|pnpm|docker|kubectl|brew|apt|ls|cd|pwd|cat|grep|ssh|curl|wget|chmod|sudo|mkdir|rm|cp|mv|ps|kill|top|find|man|node|python[0-9]*|pip[0-9]*|go|rustc|cargo|make|sh|bash|zsh|touch|which|code|open|gh|vercel|npx|deno|bun|java|rails|php|composer|gem|bundle|poetry|conda|nvm|sdk|flutter|pod|aws|gcloud|az|helm|terraform|ansible|pm2|nodemon|tsx|swc|babel|eslint|prettier|jest|vitest|playwright|lerna|nx|turbo|systemctl|export|set|env|alias|source|pkill|service|codex|claude|opencode|aider|gemini|cursor|copilot|ollama|uv|uvx|pipx|rye|mise|fnm|volta|xcodebuild|swift|xcrun|defaults|launchctl|networkQuality|ifconfig|netstat|lsof|jq|yq|rg|fd|bat|eza|tree|du|df|tar|unzip|zip|rsync|scp|sftp|act|just|task|watchexec|http|xh|sqlite3|psql|mysql|redis-cli|mongosh|firebase|supabase|wrangler|fly|railway|render|pulumi|tofu|packer|vagrant|podman|nerdctl|colima|limactl|mas|shortcuts|osascript|plutil|codesign|spctl|xattr|mdls|mdfind|sips|afconvert|say|pbcopy|pbpaste|ditto|diskutil|softwareupdate|tmutil|sysdiagnose|scutil|dscacheutil|security|profiles|pkgutil|installer|system_profiler|ioreg|powermetrics|pmset|caffeinate|screencapture|qlmanage)\\b.*"
    },
    {
      "title": {
        "en": "Open Path",
        "zh-Hans": "打开路径"
      },
      "icon": "path.svg",
      "applescript file": "path.applescript",
      "regular expression": "(?mi)^([/~]|\\.?\\./|Users/|Applications/|Volumes/|Desktop/|Downloads/|Documents/|Library/|Pictures/|Movies/|Music/|%user%(/)?)(.+)$"
    },
    {
      "title": {
        "en": "TextGenie",
        "zh-Hans": "文灵"
      },
      "icon": "translate.png",
      "javascript file": "main.js",
      "after": "preview-result"
    },
    {
      "title": {
        "en": "Check for Updates",
        "zh-Hans": "检查更新"
      },
      "icon": "update.svg",
      "javascript file": "check-updates.js",
      "regular expression": "(?i)^(textgenie update|textgenie updates|检查文灵更新)$"
    },
    {
      "title": {
        "en": "Format JSON",
        "zh-Hans": "格式化 JSON"
      },
      "icon": "json-format.svg",
      "javascript file": "format-json.js",
      "after": "preview-result",
      "requirements": [
        "text"
      ],
      "regular expression": "(?s)^\\s*[\\[{].*[\\]}]\\s*$"
    },
    {
      "title": {
        "en": "Minify JSON",
        "zh-Hans": "压缩 JSON"
      },
      "icon": "json-minify.svg",
      "javascript file": "minify-json.js",
      "after": "preview-result",
      "requirements": [
        "text"
      ],
      "regular expression": "(?s)^\\s*[\\[{].*[\\]}]\\s*$"
    },
    {
      "title": {
        "en": "URL Encode",
        "zh-Hans": "URL 编码"
      },
      "icon": "url-encode.svg",
      "javascript file": "url-encode.js",
      "after": "preview-result",
      "requirements": [
        "text"
      ],
      "regular expression": "(?i).*(https?://|www\\.|[?&=#%+]).*"
    },
    {
      "title": {
        "en": "URL Decode",
        "zh-Hans": "URL 解码"
      },
      "icon": "url-decode.svg",
      "javascript file": "url-decode.js",
      "after": "preview-result",
      "requirements": [
        "text"
      ],
      "regular expression": "(?i).*%[0-9a-f]{2}.*"
    },
    {
      "title": {
        "en": "Base64 Encode",
        "zh-Hans": "Base64 编码"
      },
      "icon": "base64-encode.svg",
      "javascript file": "base64-encode.js",
      "after": "preview-result",
      "requirements": [
        "text"
      ],
      "regular expression": "(?s)^(?!\\s*[\\[{])(?=.{32,}$|.*[\\r\\n]).*$"
    },
    {
      "title": {
        "en": "Base64 Decode",
        "zh-Hans": "Base64 解码"
      },
      "icon": "base64-decode.svg",
      "javascript file": "base64-decode.js",
      "after": "preview-result",
      "requirements": [
        "text"
      ],
      "regular expression": "(?s)^(?:[A-Za-z0-9+/]{8,}={1,2}|(?=[A-Za-z0-9+/]{12,}$)(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])[A-Za-z0-9+/]{12,}|[A-Za-z0-9+/]{24,})\\s*$"
    }
  ]
}