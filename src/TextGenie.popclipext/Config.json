{
  "name": {
    "en": "TextGenie",
    "zh-Hans": "文灵"
  },
  "identifier": "com.popclip.extension.textgenie",
  "description": {
    "en": "Magical text assistant",
    "zh-Hans": "魔法文本助手"
  },
  "icon": "icon.svg",
  "popclipVersion": 4586,
  "entitlements": ["network"],
  "options": [
    {
      "identifier": "translationService",
      "label": {
        "en": "Translation Service",
        "zh-Hans": "翻译服务"
      },
      "type": "multiple",
      "values": [
        "google",
        "deepl",
        "openai",
        "gemini",
        "custom",
        "bob",
        "eudic"
      ],
      "valueLabels": [
        "🌐 Google",
        "🔷 DeepL",
        "🤖 OpenAI",
        "✨ Gemini",
        "⚙️ Custom",
        "📖 Bob",
        "📚 Eudic"
      ],
      "defaultValue": "google"
    },
    {
      "identifier": "targetLanguage",
      "label": {
        "en": "Translation Target",
        "zh-Hans": "翻译目标语言"
      },
      "type": "multiple",
      "values": ["auto", "zh-CN", "en", "ja", "ko", "fr", "de", "es", "ru"],
      "valueLabels": [
        "🔄 Auto",
        "🇨🇳 中文",
        "🇺🇸 English",
        "🇯🇵 日本語",
        "🇰🇷 한국어",
        "🇫🇷 Français",
        "🇩🇪 Deutsch",
        "🇪🇸 Español",
        "🇷🇺 Русский"
      ],
      "defaultValue": "auto"
    },
    {
      "identifier": "apiKey",
      "label": {
        "en": "API Key",
        "zh-Hans": "API 密钥"
      },
      "type": "string",
      "description": {
        "en": "Required for DeepL/OpenAI/Gemini",
        "zh-Hans": "DeepL/OpenAI/Gemini 需要"
      }
    },
    {
      "identifier": "customApiUrl",
      "label": {
        "en": "Custom API URL",
        "zh-Hans": "自定义 API 地址"
      },
      "type": "string"
    },
    {
      "identifier": "customModel",
      "label": {
        "en": "Custom Model",
        "zh-Hans": "自定义模型"
      },
      "type": "string"
    },
    {
      "identifier": "customPrompt",
      "label": {
        "en": "Custom Prompt",
        "zh-Hans": "自定义提示词"
      },
      "type": "string"
    },
    {
      "identifier": "targetCurrency",
      "label": {
        "en": "Target Currency",
        "zh-Hans": "目标货币"
      },
      "type": "multiple",
      "values": ["CNY", "USD", "EUR", "GBP", "JPY", "HKD", "KRW", "TWD"],
      "valueLabels": [
        "¥ CNY",
        "$ USD",
        "€ EUR",
        "£ GBP",
        "¥ JPY",
        "HK$ HKD",
        "₩ KRW",
        "NT$ TWD"
      ],
      "defaultValue": "CNY"
    },
    {
      "identifier": "pureNumberMode",
      "label": {
        "en": "Pure Number Handling",
        "zh-Hans": "纯数字处理"
      },
      "type": "multiple",
      "values": ["currency", "translate"],
      "valueLabels": [
        {
          "en": "As Currency",
          "zh-Hans": "视为货币"
        },
        {
          "en": "As Text",
          "zh-Hans": "视为文本"
        }
      ],
      "defaultValue": "currency"
    },
    {
      "identifier": "openUrls",
      "label": {
        "en": "Open URLs",
        "zh-Hans": "打开网址"
      },
      "type": "boolean",
      "defaultValue": true
    },
    {
      "identifier": "enableTerminal",
      "label": {
        "en": "Enable Terminal Action",
        "zh-Hans": "开启终端功能"
      },
      "type": "boolean",
      "defaultValue": true
    },
    {
      "identifier": "preferredTerminal",
      "label": {
        "en": "Terminal Emulator",
        "zh-Hans": "终端模拟器"
      },
      "type": "multiple",
      "values": ["terminal", "iterm2", "auto"],
      "valueLabels": ["Terminal", "iTerm2", "Auto"],
      "defaultValue": "terminal"
    },
    {
      "identifier": "preferredFileManager",
      "label": {
        "en": "Preferred File Manager",
        "zh-Hans": "首选文件管理器"
      },
      "type": "multiple",
      "values": [
        "finder",
        "pathfinder",
        "forklift",
        "qspace",
        "commanderone",
        "marta"
      ],
      "valueLabels": [
        "Finder",
        "Path Finder",
        "ForkLift",
        "QSpace",
        "Commander One",
        "Marta"
      ],
      "defaultValue": "finder"
    },
    {
      "identifier": "useNewTab",
      "label": {
        "en": "Use New Tab",
        "zh-Hans": "在新标签页打开"
      },
      "type": "boolean",
      "defaultValue": false
    }
  ],
  "actions": [
    {
      "title": {
        "en": "Open URL",
        "zh-Hans": "打开网址"
      },
      "icon": "url.png",
      "javascript file": "url.js",
      "regular expression": "(?i)^(https?://|www\\.|[a-z0-9-]+\\.[a-z]{2,}(/.*)?$|(\\d{1,3}\\.){3}\\d{1,3}(:\\d+)?(/.*)?$|localhost(:\\d+)?(/.*)?$)"
    },
    {
      "title": {
        "en": "Convert",
        "zh-Hans": "汇率转换"
      },
      "icon": "currency.png",
      "javascript file": "currency.js",
      "after": "preview-result",
      "regular expression": "(?i).*([$¥€£₹₩₽฿]|USD|CNY|EUR|GBP|JPY|HKD|KRW|TWD|SGD|AUD|CAD|CHF|THB|INR|RUB|元|币|镑|法郎|铢|卢|円).*"
    },
    {
      "title": {
        "en": "Run in Terminal",
        "zh-Hans": "填入终端"
      },
      "icon": "terminal.png",
      "applescript file": "terminal.applescript",
      "requirements": ["text", "option-preferredTerminal=terminal"],
      "regular expression": "(?i)^([$#>%\\s]*)(git|npm|yarn|pnpm|docker|kubectl|brew|apt|ls|cd|pwd|cat|grep|ssh|curl|wget|chmod|sudo|mkdir|rm|cp|mv|ps|kill|top|find|man|node|python[0-9]*|pip[0-9]*|go|rustc|cargo|make|sh|bash|zsh|touch|which|code|open|gh|vercel|npx|deno|bun|java|rails|php|composer|gem|bundle|poetry|conda|nvm|sdk|flutter|pod|aws|gcloud|az|helm|terraform|ansible|pm2|nodemon|tsx|swc|babel|eslint|prettier|jest|vitest|playwright|lerna|nx|turbo|systemctl|export|set|env|alias|source|pkill|service)\\b.*"
    },
    {
      "title": {
        "en": "Run in Terminal",
        "zh-Hans": "填入终端"
      },
      "icon": "terminal.png",
      "applescript file": "iterm2.applescript",
      "requirements": ["text", "option-preferredTerminal=iterm2"],
      "app": {
        "name": "iTerm2",
        "link": "https://iterm2.com/",
        "bundleIdentifiers": ["com.googlecode.iterm2"]
      },
      "regular expression": "(?i)^([$#>%\\s]*)(git|npm|yarn|pnpm|docker|kubectl|brew|apt|ls|cd|pwd|cat|grep|ssh|curl|wget|chmod|sudo|mkdir|rm|cp|mv|ps|kill|top|find|man|node|python[0-9]*|pip[0-9]*|go|rustc|cargo|make|sh|bash|zsh|touch|which|code|open|gh|vercel|npx|deno|bun|java|rails|php|composer|gem|bundle|poetry|conda|nvm|sdk|flutter|pod|aws|gcloud|az|helm|terraform|ansible|pm2|nodemon|tsx|swc|babel|eslint|prettier|jest|vitest|playwright|lerna|nx|turbo|systemctl|export|set|env|alias|source|pkill|service)\\b.*"
    },
    {
      "title": {
        "en": "Run in Terminal",
        "zh-Hans": "填入终端"
      },
      "icon": "terminal.png",
      "applescript file": "terminal.applescript",
      "requirements": ["text", "option-preferredTerminal=auto"],
      "regular expression": "(?i)^([$#>%\\s]*)(git|npm|yarn|pnpm|docker|kubectl|brew|apt|ls|cd|pwd|cat|grep|ssh|curl|wget|chmod|sudo|mkdir|rm|cp|mv|ps|kill|top|find|man|node|python[0-9]*|pip[0-9]*|go|rustc|cargo|make|sh|bash|zsh|touch|which|code|open|gh|vercel|npx|deno|bun|java|rails|php|composer|gem|bundle|poetry|conda|nvm|sdk|flutter|pod|aws|gcloud|az|helm|terraform|ansible|pm2|nodemon|tsx|swc|babel|eslint|prettier|jest|vitest|playwright|lerna|nx|turbo|systemctl|export|set|env|alias|source|pkill|service)\\b.*"
    },
    {
        "title": {
            "en": "Open Path",
            "zh-Hans": "打开路径"
        },
        "icon": "path.svg",
        "applescript file": "path.applescript",
        "regular expression": "(?mi)^([/~]|\\.?\\./|Users/|Applications/|Volumes/|Desktop/|Downloads/|Documents/|Library/|Pictures/|Movies/|Music/|%user%(/)?)(.+)$"
    },
    {
      "title": {
        "en": "TextGenie",
        "zh-Hans": "文灵"
      },
      "icon": "translate.png",
      "javascript file": "main.js",
      "after": "preview-result"
    }
  ]
}
